{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Helmor",
	"version": "0.46.0",
	"identifier": "ai.helmor.desktop",
	"build": {
		"beforeDevCommand": "bun x vite",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "node scripts/prepare-sidecar.mjs && bun run build",
		"frontendDist": "../dist"
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["helmor", "helmor-dev"]
			}
		}
	},
	"app": {
		"macOSPrivateApi": true,
		"windows": [
			{
				"title": "Helmor",
				"width": 1300,
				"height": 810,
				"minWidth": 900,
				"minHeight": 600,
				"titleBarStyle": "Overlay",
				"trafficLightPosition": {
					"x": 12,
					"y": 20
				},
				"hiddenTitle": true,
				"center": true,
				"backgroundColor": "#0E0E0E"
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": {
					"allow": ["**"]
				}
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app", "dmg"],
		"externalBin": ["../sidecar/dist/helmor-sidecar"],
		"resources": {
			"../sidecar/dist/vendor/": "vendor"
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.ico",
			"icons/icon.icns"
		],
		"macOS": {
			"entitlements": "Entitlements.plist"
		},
		"windows": {
			"nsis": {
				"installMode": "currentUser"
			}
		}
	}
}
