---
source: tests/streaming_send_params.rs
expression: "&params"
---
claudeConfigDir: /data/local-llm/claude-home
claudeEnvironment:
  ANTHROPIC_API_KEY: ""
  ANTHROPIC_AUTH_TOKEN: helmor-local-token
  ANTHROPIC_BASE_URL: "http://127.0.0.1:18777"
  ANTHROPIC_DEFAULT_FABLE_MODEL: helmor-local
  ANTHROPIC_DEFAULT_HAIKU_MODEL: helmor-local
  ANTHROPIC_DEFAULT_OPUS_MODEL: helmor-local
  ANTHROPIC_DEFAULT_SONNET_MODEL: helmor-local
  ANTHROPIC_MODEL: helmor-local
  ANTHROPIC_SMALL_FAST_MODEL: helmor-local
  CLAUDE_CODE_AUTO_COMPACT_WINDOW: "65536"
  CLAUDE_CODE_DISABLE_ADVISOR_TOOL: "1"
  CLAUDE_CODE_DISABLE_AUTO_MEMORY: "1"
  CLAUDE_CODE_DISABLE_BACKGROUND_TASKS: "1"
  CLAUDE_CODE_DISABLE_BUNDLED_SKILLS: "1"
  CLAUDE_CODE_DISABLE_CLAUDE_MDS: "1"
  CLAUDE_CODE_DISABLE_CRON: "1"
  CLAUDE_CODE_DISABLE_EXPLORE_PLAN_AGENTS: "1"
  CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC: "1"
  CLAUDE_CODE_DISABLE_THINKING: "1"
  CLAUDE_CODE_DISABLE_WORKFLOWS: "1"
  CLAUDE_CODE_MAX_CONTEXT_TOKENS: "65536"
  CLAUDE_CODE_MAX_OUTPUT_TOKENS: "16384"
  DISABLE_AUTOUPDATER: "1"
  DISABLE_ERROR_REPORTING: "1"
  DISABLE_TELEMETRY: "1"
  MCP_CONNECTION_NONBLOCKING: "0"
claudeSettings:
  enableAllProjectMcpServers: false
  permissions:
    deny:
      - WebSearch
      - WebFetch
      - Agent
      - AskUserQuestion
      - CronCreate
      - CronDelete
      - CronList
      - EnterPlanMode
      - EnterWorktree
      - ExitWorktree
      - ListAgents
      - NotebookEdit
      - ReportFindings
      - ScheduleWakeup
      - SendMessage
      - Skill
      - TaskStop
      - Workflow
cwd: /abs/workspace
effortLevel: ~
fastMode: false
model: helmor-local
permissionMode: bypassPermissions
prompt: hello
provider: claude
resume: ~
sessionId: sidecar-sess-1
